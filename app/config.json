  "scoring": {
    "low_quantile": 0.05,
    "high_quantile": 0.99,
    "min_metric_population": 6,
    "min_coverage": 0.35,
    "confident_coverage": 0.6,
    "score_floor_for_ratio": 5
  },
  "categories": {
    "coding": {
      "label": "Coding / Engineering",
      "short": "Coding",
      "explain": "How well a model writes, fixes and reviews software: patching real repositories, solving programming exercises and building working apps and UIs. Matters most for coding aliases and agent loops that edit code.",
      "metrics": {
        "aa_coding": 3,
        "swe_bench_verified": 2,
        "arena_webdev": 1.5,
        "arena_coding": 1.5,
        "aider_polyglot": 1,
        "scicode": 1,
        "design_arena_code": 0.5
      }
    },
    "agentic": {
      "label": "Agentic task execution",
      "short": "Agentic",
      "explain": "How reliably a model does multi-step work on its own: choosing and calling tools, working in a terminal, recovering from errors and finishing long tasks. The key dimension for autonomous task aliases.",
      "metrics": {
        "aa_agentic": 3,
        "terminal_bench": 2,
        "apex_agents": 2,
        "arena_agent": 2
      }
    },
    "reasoning": {
      "label": "Reasoning & problem solving",
      "short": "Reasoning",
      "explain": "How well a model solves hard problems that need careful multi-step thought: graduate-level science, maths, abstract puzzles and expert questions. The key dimension for reasoning aliases.",
      "metrics": {
        "aa_intelligence": 2,
        "epoch_eci": 2,
        "gpqa_diamond": 2,
        "hle": 2,
        "arc_agi_2": 1.5,
        "frontiermath": 1,
        "arena_hard_prompts": 1
      }
    },
    "chat": {
      "label": "Everyday agent chat",
      "short": "Chat",
      "explain": "How useful and pleasant the model is in everyday conversation as judged by people: following instructions, handling multi-turn dialogue, answering clearly. The key dimension for everyday and budget aliases.",
      "metrics": {
        "arena_text": 3,
        "arena_instruction_following": 1.5,
        "arena_multi_turn": 1.5,
        "aa_intelligence": 1
      }
    }
  },
  "aliases": {
    "Free": {
      "note": "Zero-cost models only (free tiers on OpenRouter and Nous Portal). Rate-limited; check data-use terms.",
      "max_cost": 0,
      "require": [
        "free"
      ],
      "min_share": 0.4,
      "weights": {
        "chat": 0.4,
        "agentic": 0.2,
        "coding": 0.2,
        "reasoning": 0.2

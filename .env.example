# Copy to .env (never commit it). See app/modelfit/settings.py for every option.

# selfhost (single user, no sign-in) or cloud (the SaaS)
MODELFIT_MODE=cloud
# production refuses to start without the secure settings below
MODELFIT_ENV=production
MODELFIT_BASE_URL=https://modelfit.ai
# 32+ random characters, e.g. python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MODELFIT_SECRET_KEY=
MODELFIT_DB=/data/modelfit.db
MODELFIT_DATA_DIR=/data/market
# extra Host headers to accept (comma-separated), e.g. www.modelfit.ai
# MODELFIT_ALLOWED_HOSTS=

# Stripe (Dashboard -> Developers). Webhook endpoint: https://<your-domain>/api/billing/webhook
# events: checkout.session.completed, customer.subscription.created/updated/deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=

# selfhost only: seed the workspace webhook (replaces the old config.json "webhook" block)
# MODELFIT_WEBHOOK_URL=http://127.0.0.1:8791/sync
# MODELFIT_WEBHOOK_SECRET=
# selfhost only: the routing gateway's upstream key when none is stored in the app
# OPENROUTER_API_KEY=
# the gateway's OpenAI-compatible upstream (default https://openrouter.ai/api/v1)
# MODELFIT_UPSTREAM_URL=

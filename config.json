{
  "server": { "host": "127.0.0.1", "port": 8787 },

  "refresh": {
    "intervals_minutes": {
      "openrouter": 30,
      "nous": 30,
      "litellm": 360,
      "arena": 720,
      "epoch": 1440
    },
    "min_force_minutes": {
      "openrouter": 2,
      "nous": 2,
      "litellm": 30,
      "arena": 120,
      "epoch": 120
    },
    "check_seconds": 60,
    "workers": 8
  },

  "cost": {
    "blend": { "input": 3, "output": 1 },
    "exclude_variants": ["batch", "US"],
    "min_uptime_pct": 80,
    "include_service_tiers": [],
    "exclude_quantizations": ["int4", "fp4", "mxfp4", "nvfp4"],
    "primary_litellm_providers": {
      "openai": ["openai"], "anthropic": ["anthropic"], "gemini": ["google"], "xai": ["x-ai"],
      "deepseek": ["deepseek"], "mistral": ["mistralai"], "moonshot": ["moonshotai"],
      "zai": ["z-ai"], "minimax": ["minimax"], "dashscope": ["qwen"],
      "meta_llama": ["meta-llama", "meta"], "tencent": ["tencent"], "xiaomi_mimo": ["xiaomi"],
      "cohere_chat": ["cohere"]
    },
    "primary_openrouter_providers": {
      "qwen": ["Alibaba"],
      "meta-llama": ["Meta"],
      "meta": ["Meta"]
    }
  },

  "scoring": {
    "low_quantile": 0.05,
    "high_quantile": 0.99,
    "min_metric_population": 6,
    "min_coverage": 0.35,
    "confident_coverage": 0.6,
    "score_floor_for_ratio": 5
  },

  "categories": {
    "coding": {
      "label": "Coding / Engineering",
      "short": "Coding",
      "explain": "How well a model writes, fixes and reviews software: patching real repositories, solving programming exercises and building working apps and UIs. Matters most for your Coding alias and for agent loops that edit code.",
      "metrics": {
        "aa_coding": 3,
        "swe_bench_verified": 2,
        "arena_webdev": 1.5,
        "arena_coding": 1.5,
        "aider_polyglot": 1,
        "scicode": 1,
        "design_arena_code": 0.5
      }
    },
    "agentic": {
      "label": "Agentic task execution",
      "short": "Agentic",
      "explain": "How reliably a model does multi-step work on its own: choosing and calling tools, working in a terminal, recovering from errors and finishing long tasks. The key dimension for your Task alias.",
      "metrics": {
        "aa_agentic": 3,
        "terminal_bench": 2,
        "apex_agents": 2,
        "arena_agent": 2
      }
    },
    "reasoning": {
      "label": "Reasoning & problem solving",
      "short": "Reasoning",
      "explain": "How well a model solves hard problems that need careful multi-step thought: graduate-level science, maths, abstract puzzles and expert questions. The key dimension for your Thinking alias.",
      "metrics": {
        "aa_intelligence": 2,
        "epoch_eci": 2,
        "gpqa_diamond": 2,
        "hle": 2,
        "arc_agi_2": 1.5,
        "frontiermath": 1,
        "arena_hard_prompts": 1
      }
    },
    "chat": {
      "label": "Everyday agent chat",
      "short": "Chat",
      "explain": "How useful and pleasant the model is in everyday conversation as judged by people: following instructions, handling multi-turn dialogue, answering clearly. The key dimension for Free, Cheap and Daily.",
      "metrics": {
        "arena_text": 3,
        "arena_instruction_following": 1.5,
        "arena_multi_turn": 1.5,
        "aa_intelligence": 1
      }
    }
  },

  "aliases": {
    "Free": {
      "note": "Zero-cost models only (OpenRouter :free, Nous Portal :free).",
      "max_cost": 0,
      "require": ["free"],
      "min_share": 0.4,
      "weights": { "chat": 0.4, "agentic": 0.2, "coding": 0.2, "reasoning": 0.2 }
    },
    "Cheap": {
      "note": "High-volume utility work: summaries, routing, classification, sub-agents.",
      "max_cost": 0.1,
      "weights": { "chat": 0.4, "agentic": 0.3, "reasoning": 0.15, "coding": 0.15 }
    },
    "Daily": {
      "note": "Default conversational driver. No cap was specified; 0.50 is an assumption, edit freely.",
      "max_cost": 0.5,
      "weights": { "chat": 0.45, "agentic": 0.25, "reasoning": 0.15, "coding": 0.15 }
    },
    "Big": {
      "note": "Stronger all-rounder under $1/M.",
      "max_cost": 1.0,
      "weights": { "chat": 0.25, "agentic": 0.25, "reasoning": 0.25, "coding": 0.25 }
    },
    "Jumbo": {
      "note": "Strongest all-rounder under $2/M.",
      "max_cost": 2.0,
      "weights": { "chat": 0.25, "agentic": 0.25, "reasoning": 0.25, "coding": 0.25 }
    },
    "Thinking": {
      "note": "Hard reasoning / planning. Needs reasoning support. No cost cap by default.",
      "max_cost": null,
      "require": ["reasoning"],
      "weights": { "reasoning": 0.7, "agentic": 0.15, "chat": 0.15 }
    },
    "Coding": {
      "note": "Software engineering. Needs tool use and a large context. No cost cap by default.",
      "max_cost": null,
      "require": ["tools"],
      "min_context": 128000,
      "weights": { "coding": 0.75, "agentic": 0.25 }
    },
    "Task": {
      "note": "Autonomous multi-step task execution. Needs tool use and a large context. No cost cap by default.",
      "max_cost": null,
      "require": ["tools"],
      "min_context": 128000,
      "weights": { "agentic": 0.75, "coding": 0.15, "reasoning": 0.1 }
    }
  },

  "alias_value_tolerance": 0.1,
  "current_models": {
    "Free": null, "Cheap": null, "Daily": null, "Big": null,
    "Jumbo": null, "Thinking": null, "Coding": null, "Task": null
  },

  "age": { "fresh_days": 90, "faded_days": 450, "min_opacity": 0.12 },

  "name_overrides": {}
}
